# Root secrets used by build tooling and copied into each part's own .env by setup.
# Fill these in, then run the per-part setup described in README.md.

# fal.ai (asset generation)
FAL_KEY=

# ElevenLabs (call sample audio + voice agent)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# Twilio (number imported into ElevenLabs for outbound calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Your phone, registered as Alex's number for the reminder call demo (E.164)
DEMO_RECEIVER_PHONE=

# Anthropic (send agent)
ANTHROPIC_API_KEY=

# Arc testnet deployer / contract owner / demo faucet. Fund at https://faucet.circle.com (Arc Testnet)
DEPLOYER_PRIVATE_KEY=

# QuickNode Streams (optional: webhook security token for /webhooks/quicknode)
QUICKNODE_STREAM_TOKEN=

# QuickNode Arc testnet HTTP endpoint (optional, faster RPC than the public one)
QUICKNODE_RPC_URL=
