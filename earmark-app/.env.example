# earmark-app server (.env is gitignored). Shared secrets come from the repo root .env.
PORT=8787
EARMARK_APP_URL=http://localhost:5173
EARMARK_API_URL=http://localhost:8787
HARTWELL_URL=http://localhost:5174
HARTWELL_API_URL=http://localhost:8788

# Arc testnet. The contract address is read at runtime from contracts/deployments/arc-testnet.json.
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_EXPLORER=https://explorer.testnet.arc.io
# EARMARK_DEPLOYMENT=../contracts/deployments/arc-testnet.json
# Override instead of the deployment file (e.g. a local anvil): EARMARK_ADDRESS, USDC_ADDRESS, CHAIN_ID, DEPLOY_BLOCK

# Contract owner key: registerStore for /stores and the /api/demo/fund faucet. Never the store's key.
DEPLOYER_PRIVATE_KEY=

# Send agent (Claude API). Empty = deterministic rules parser.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# QuickNode Streams. true = expect deliveries on POST /webhooks/quicknode; otherwise a viem poller watches the chain.
QUICKNODE_ENABLED=false
QUICKNODE_STREAM_TOKEN=

# ElevenLabs Agents + Twilio (number imported into ElevenLabs). Empty = "Call me now" plays the recorded sample.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Public URL of this server (tunnel) for the phone tool webhook. Empty locally.
PUBLIC_API_URL=
# Optional shared secret the agent's purchase tool sends as x-earmark-tool-secret
ELEVENLABS_TOOL_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Alex's phone for the reminder call demo (E.164)
DEMO_RECEIVER_PHONE=

# Shared demo accounts (one Maya, one Alex for everyone). The server signs for them, only Earmark calls.
DEMO_MAYA_PRIVATE_KEY=
DEMO_ALEX_PRIVATE_KEY=
