# Hartwell Supply backend. Copy to .env (or run `npm run store-key`, which creates .env for you).

# Store signer key. Generated by `npm run store-key`. Never commit. For the demo the signer is also the payout address.
HARTWELL_SIGNER_PRIVATE_KEY=
# Optional: payout address if it differs from the signer (defaults to the signer address)
HARTWELL_STORE_ADDRESS=

# Earmark
EARMARK_APP_URL=http://localhost:5173
EARMARK_API_URL=http://localhost:8787

# Arc testnet
ARC_RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002
# Optional. If empty, read from ../../contracts/deployments/arc-testnet.json at runtime
EARMARK_CONTRACT=

# This store
HARTWELL_URL=http://localhost:5174
HARTWELL_API_URL=http://localhost:8788
PORT=8788
